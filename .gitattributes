# Shell scripts run inside Linux containers, so they keep LF on every checkout.
mvnw text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
# The generated API files are written with LF, so they keep LF on every checkout too, or a Windows
# checkout shows them changed after the gate.
docs/api/openapi.yaml text eol=lf
# Generated from docs/api/openapi.yaml by `pnpm api:generate`. The document itself stays expanded
# in diffs, since it is where a reviewer sees an API change.
frontend/src/api/schema.d.ts linguist-generated=true text eol=lf
